import traceback
from typing import Any

from .response import ResponseModel


def dispatch(
    execution_mode: str,  # TODO: literal type
    mock_io: bool,
    params: dict[str, Any],
    validate_params_schema: bool = True,
) -> ResponseModel:
    match execution_mode, mock_io:
        case ("sequential", True):
            from .dags.run_sequential_mock_io import main as dispatcher

        case ("sequential", False):
            from .dags.run_sequential import main as dispatcher

        case _:
            raise ValueError(f"Invalid execution mode: {execution_mode}")

    try:
        result = dispatcher(params=params, validate_params_schema=validate_params_schema)
        {%- if cache %}
        # Read after the DAG's run scope has closed, which is where the report
        # of what each step's cache actually did ends up.
        from wt_task.cache import run_report

        response = ResponseModel(result=result, cache=run_report())
        {%- else %}
        response = ResponseModel(result=result)
        {%- endif %}
        response.model_dump_json()  # eagerly validate JSON-serializability
    except Exception as e:
        trace = traceback.format_exc()
        response = ResponseModel(error=str(e), trace=trace)

    return response
