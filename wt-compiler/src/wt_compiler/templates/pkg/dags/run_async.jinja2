from ..params import Params


def main(params: Params):
    {%- if testing %}
    warnings.warn("This test script should not be used in production!")  # 🧪
    {% endif %}
    params_dict = json.loads(params.model_dump_json(exclude_unset=True))

    dependencies = {{ spec.task_instance_dependencies }}

    nodes = {
        {% for t in spec.flat_workflow %}
        {% set validate = true %}
        {% set params = '(params_dict.get("' ~ t.id ~ '") or {})' %}
        {% set set_executor = '"lithops"' %}
        "{{ t.id }}": Node(
            async_task={{ call_task_macros.create_callable(t, false, false, validate, false, set_executor) }},
            {% if t.partial %}
            partial={
                {% for arg in t.partial %}
                {% if t.partial[arg]["has_variable_values"] %}
                "{{ arg }}": {
                    {% for nested_arg, nested_value in t.partial[arg]["asdict"].items() %}
                    {{ call_task_macros.handle_async_partial_arg(nested_arg, nested_value) }}
                    {% endfor %}
                },
                {% else %}
                {{ call_task_macros.handle_async_partial_arg(arg, t.partial[arg]) }}
                {% endif %}
                {% endfor %}
            } | {{ params }},
            {% else %}
            partial={{ params }},
            {% endif %}
            method="{{ t.method }}",
            {% if t.method != "call" %}
            {% if t.method == "map" %}
                {% set argnames = t.map.argnames %}
                {% set argvalues = t.map.argvalues["aslist"] %}
            {% elif t.method == "mapvalues" %}
                {% set argnames = t.mapvalues.argnames %}
                {% set argvalues = t.mapvalues.argvalues["aslist"] %}
            {% endif %}
            kwargs={
                "argnames": {{ argnames }},
                {% if argvalues|length > 1 %}
                "argvalues": DependsOnSequence(
                    [
                        {% for v in argvalues %}
                        DependsOn("{{ v }}"),
                        {% endfor %}
                    ],
                ),
                {% else %}
                "argvalues": DependsOn("{{ argvalues[0] }}"),
                {% endif %}
            },
            {% endif %}
        ),
        {% endfor -%}
    }
    graph = Graph(dependencies=dependencies, nodes=nodes)
    results = graph.execute()
    return results
