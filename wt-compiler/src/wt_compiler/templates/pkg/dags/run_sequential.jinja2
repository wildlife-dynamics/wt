def main(params: dict[str, Any], validate_params_schema: bool = True):
    # One spelling per meaning, whichever producer wrote the params, so step keys
    # agree across them (a default spelled out, an untouched multi-select as []).
    params = canonical_params(params, _metadata.load_params_schema(), rules={{ canonical_params_rules }})
    # A task-instance id only names a step within one run, so the id -> digest
    # table that resolves upstream inputs is per execution. Stored entries are
    # keyed by content, never by id, so they are still shared across runs and
    # workflows.
    with run_scope(params=params):
        return _main(params, validate_params_schema)


