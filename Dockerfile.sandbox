ARG BASE=ghcr.io/raine/workmux-sandbox:claude
FROM ${BASE}

# Install uv and pre-commit to globally accessible paths so the binaries are
# reachable when running as an arbitrary non-root UID (--user uid:gid).
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
    mv /root/.local/bin/uv /opt/uv && \
    ln -s /opt/uv /usr/local/bin/uv && \
    UV_TOOL_BIN_DIR=/usr/local/bin UV_TOOL_DIR=/opt/uv-tools uv tool install pre-commit
