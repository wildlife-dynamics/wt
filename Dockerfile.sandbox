ARG BASE=ghcr.io/raine/workmux-sandbox:claude
FROM ${BASE}

# Install uv, then move to a globally accessible path so the binary
# is reachable when running as an arbitrary non-root UID (--user uid:gid).
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
    mv /root/.local/bin/uv /opt/uv && \
    ln -s /opt/uv /usr/local/bin/uv
